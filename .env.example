# Copy to .env and fill in. Never commit .env.
# One block per site; --site mysite reads SITE_MYSITE_*.

SITE_MYSITE_URL=https://www.example.com
SITE_MYSITE_USER=
SITE_MYSITE_PASSWORD=
# Front-end pages to snapshot (comma-separated paths). The latest blog post is added automatically.
SITE_MYSITE_PAGES=/
# Informational: set to true when this block points at a staging copy.
SITE_MYSITE_IS_STAGING=false

# Claude API key for the planner and page designer (plan, rebuild).
ANTHROPIC_API_KEY=
